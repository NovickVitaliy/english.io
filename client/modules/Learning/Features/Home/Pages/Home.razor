@page "/learning/home"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Learning.Features.Home.Components
@using Learning.Layouts
@layout DashboardLayout
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <HomeMain />
    <Statistics />
    <MudGrid Justify="Justify.Center" Class="mt-4">
        <MudItem xs="12" md="4">
            <QuickAccess />
        </MudItem>
        <MudItem xs="12" md="4">
            <RandomMotivationalPhrase />
        </MudItem>
        <MudItem xs="12" md="4">
            <WordOfTheDay />
        </MudItem>
    </MudGrid>
</MudContainer>
