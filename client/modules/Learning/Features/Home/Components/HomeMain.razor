@using MudBlazor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<div style="padding: 48px 0 32px 0;">
    <MudStack AlignItems="AlignItems.Center" Spacing="4">
        <MudText Typo="Typo.overline" Color="Color.Primary" Style="letter-spacing: 0.15em;">
            Dashboard
        </MudText>
        <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 700;">
            @Localizer["Home_Welcome", UserState.Value.Username]
        </MudText>
        <MudButton Href="/learning/decks"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Style="border-radius: 14px; text-transform: none; font-weight: 700; font-size: 1rem; padding: 14px 28px;">
            @Localizer["Home_Prompt"]
        </MudButton>
    </MudStack>
</div>
