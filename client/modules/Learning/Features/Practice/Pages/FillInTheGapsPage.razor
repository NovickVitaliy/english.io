@page "/practice/{deckId:guid}/fill-in-the-gaps"
@using Learning.Layouts
@using MudBlazor
@layout DashboardLayout
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Class="mb-3" Align="Align.Center"
             Typo="Typo.h3">@Localizer["Title"]</MudText>
    <MudButton OnClick="NextExercise">
        Skip
    </MudButton>
    <div>
        @if (FillInTheGapsState.Value.IsLoading)
        {
            <MudText>@Localizer["Loading_Sentences"]...</MudText>
        }
        @if (FillInTheGapsState.Value.SentencesWithGap.Length > 0 && !FillInTheGapsState.Value.IsLoading)
        {
            @if (HasVerified)
            {
                <div class="d-flex justify-content-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="NextExercise">@Localizer["Next_Exercise"]</MudButton>
                </div>
            }
            @for (var i = 0; i < FillInTheGapsState.Value.SentencesWithGap.Length; i++)
            {
                var sentence = FillInTheGapsState.Value.SentencesWithGap[i];
                var splitSentence = sentence.Sentence.Split("*****").Select(x => x.Trim()).ToArray();
                var beforeGap = splitSentence[0];
                var afterGap = splitSentence[1];
                var index = i;

                _request.SentencesWithFilledGaps[index].SenseId = sentence.SenseId;
                _request.SentencesWithFilledGaps[index].CorrectWord = sentence.CorrectWord;
                _request.SentencesWithFilledGaps[index].Sentence = sentence.Sentence;

                <div class="d-flex w-100 gap-3 align-items-center justify-content-start">
                    <MudPaper Class="w-100 mb-5 p-3">
                        <div class="d-flex mb-3 text-nowrap">
                            <MudText>
                                @beforeGap
                            </MudText>
                            <MudTextField Class="ms-3 me-3" T="string"
                                          @bind-Value="_request!.SentencesWithFilledGaps[index].FilledInWord"></MudTextField>
                            <MudText>
                                @afterGap
                            </MudText>
                        </div>
                        @if (HasVerified)
                        {
                            var fillInTheGapsResult = FillInTheGapsTaskResultState.Value.ForWord(sentence.SenseId);
                            if (fillInTheGapsResult is not null)
                            {
                                <div class="d-flex gap-1">
                                    <MudText>@(fillInTheGapsResult.IsCorrect ? "✅" : "❌")</MudText>
                                    @if (!fillInTheGapsResult.IsCorrect)
                                    {
                                        <MudText>@Localizer["Correct_Answer"]: @fillInTheGapsResult.CorrectWord</MudText>
                                    }
                                </div>
                            }
                        }
                    </MudPaper>

                </div>
            }

            <MudButton Class="w-100" Disabled="HasVerified" OnClick="VerifySentences" Variant="Variant.Filled"
                       Color="Color.Primary">@Localizer["Verify_Sentences"]</MudButton>
        }
    </div>
</MudContainer>

<MudOverlay Visible="@(FillInTheGapsState.Value.IsLoading || FillInTheGapsTaskResultState.Value.IsLoading)" DarkBackground="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
</MudOverlay>

