@page "/practice/{deckId:guid}/reading-comprehension"
@layout EmptyLayout
@using MudBlazor
@using Shared.Layout

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudButton OnClick="NextExercise">
        Skip
    </MudButton>
    @if (ReadingComprehensionTaskState.Value.IsLoading)
    {
        <MudText Typo="Typo.h5">@Localizer["Loading"]</MudText>
    }
    else if (!ReadingComprehensionTaskState.Value.IsLoading
             && ReadingComprehensionTaskState.Value.ReadingComprehensionExercise is not null
             && _checkReadingComprehensionExerciseRequest is not null)
    {
        <MudText Typo="Typo.h5">@Localizer["Header"]</MudText>
        <MudPaper Class="p-3 mb-3">
            <MudText>@ReadingComprehensionTaskState.Value.ReadingComprehensionExercise.Text</MudText>
        </MudPaper>
        @for (var index = 0; index < ReadingComprehensionTaskState.Value.ReadingComprehensionExercise.Questions.Length; index++)
        {
            var i = index;
            var question = ReadingComprehensionTaskState.Value.ReadingComprehensionExercise.Questions[index];
            <MudPaper Class="p-3 mb-3">
                <div class="d-flex justify-content-start align-items-center">
                    @if (ReadingComprehensionTaskResultState.Value.Result is not null && !ReadingComprehensionTaskResultState.Value.IsLoading)
                    {
                        var checkAnswerResult = ReadingComprehensionTaskResultState.Value.Result.AnswersResults[i];
                        <MudText>@(checkAnswerResult.IsCorrect ? "✅" : "❌")</MudText>
                    }
                    <MudText>@question</MudText>
                </div>
                <MudInput @bind-Value="_checkReadingComprehensionExerciseRequest!.Answers[i]"></MudInput>
                @if (ReadingComprehensionTaskResultState.Value.Result is not null)
                {
                    var checkAnswerResult = ReadingComprehensionTaskResultState.Value.Result.AnswersResults[i];
                    @if (!checkAnswerResult.IsCorrect)
                    {
                        <MudText>@Localizer["Correct_Answer"] @checkAnswerResult.CorrectAnswer</MudText>
                    }
                }
            </MudPaper>
        }
        <div class="d-flex justify-content-start gap-3">
            <MudButton OnClick="CheckReadingComprehension" Color="Color.Primary"
                       Variant="Variant.Filled">@Localizer["Check_Button"]</MudButton>
            @if (ReadingComprehensionTaskResultState.Value.Result is not null)
            {
                <MudButton OnClick="NextExercise" Color="Color.Primary"
                           Variant="Variant.Filled">@Localizer["Next_Exercise_Button"]</MudButton>
            }
        </div>
    }
</MudContainer>
<MudOverlay Visible="ReadingComprehensionTaskState.Value.IsLoading" DarkBackground="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
</MudOverlay>
