@page "/practice/example-text"
@using System.Text.RegularExpressions
@using Learning.Layouts
@using MudBlazor
@layout DashboardLayout
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Class="mb-3" Align="Align.Center"
             Typo="Typo.h3">@Localizer["Title"]</MudText>
    @if (!ExampleTextTaskState.Value.IsLoading)
    {
        var text = new MarkupString(Regex.Replace(ExampleTextTaskState.Value.Text, UsedWordPattern, Replacement));
        <MudPaper Class="p-3">
            <MudText Typo="Typo.body1">
                @text
            </MudText>
            <div class="mt-3 d-flex justify-content-center align-items-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="FinishPractice">
                    @Localizer["Finish_Practice"]
                </MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>

<MudOverlay Visible="@(ExampleTextTaskState.Value.IsLoading)" DarkBackground="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
</MudOverlay>
