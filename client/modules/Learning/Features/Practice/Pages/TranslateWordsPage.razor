@page "/practice/{deckId:guid}/translate-words"
@using Learning.Layouts
@using MudBlazor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@layout DashboardLayout

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Class="mb-3" Align="Align.Center"
             Typo="Typo.h3">@Localizer["Title", OriginalLanguage, TranslateLanguage]</MudText>
    <MudButton OnClick="NextExercise">Skip</MudButton>
    <div class="d-flex justify-content-start mb-5">
        @if (TranslateWordsTaskResultState.Value.Results.Length > 0 && !TranslateWordsTaskResultState.Value.IsLoading)
        {
            <MudButton Class="w-100" OnClick="NextExercise" Color="Color.Primary"
                       Variant="Variant.Filled">@Localizer["Next_Exercise"]</MudButton>
        }
    </div>
    <MudForm Model="_taskRequest">
        @if (TranslateWordsState.Value is { Words.Length: > 0})
        {
            @for (var i = 0; i < TranslateWordsState.Value.Words.Length; i++)
            {
                var word = TranslateWordsState.Value.Words[i];
                var label = word.Word + (string.IsNullOrWhiteSpace(word.Definition) ? "" : $" ({word.Definition})");
                var index = i;
                _taskRequest.TranslatedWords[index].OriginalWord = word.Word;
                _taskRequest.TranslatedWords[index].Definition = word.Definition;
                _taskRequest.TranslatedWords[index].SenseId = word.SenseId;
                <MudPaper Class="d-flex flex-column gap-3 p-2 mb-3 justify-content-between">
                    <MudText Align="Align.Center" Class="w-100 text-center me-3" Typo="Typo.h6">
                        @label
                    </MudText>
                    <MudTextField T="string" @bind-Value="_taskRequest.TranslatedWords[index].Translated"></MudTextField>
                    @if (TranslateWordsTaskResultState.Value.Results.Length > 0 && !TranslateWordsTaskResultState.Value.IsLoading)
                    {
                        var wordTranslationResult = TranslateWordsTaskResultState.Value.ForWord(word.SenseId);
                        if (wordTranslationResult is not null)
                        {
                            <div class="d-flex">
                                <MudText Class="me-3">@(wordTranslationResult.IsCorrect ? "✅" : "❌")</MudText>
                                @if (!wordTranslationResult.IsCorrect)
                                {
                                    <MudText>@Localizer["Correct_Translation"] @(wordTranslationResult.CorrectTranslation)</MudText>
                                }
                            </div>
                        }
                    }
                </MudPaper>
            }

            <MudButton Disabled="@(TranslateWordsTaskResultState.Value.Results.Length > 0 && !TranslateWordsTaskResultState.Value.IsLoading)" Class="mb-3" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="VerifyTranslatedWords">
                @Localizer["Verify_Words"]
            </MudButton>
        }
    </MudForm>
</MudContainer>

<MudOverlay Visible="TranslateWordsTaskResultState.Value.IsLoading" DarkBackground="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true"/>
</MudOverlay>

